# Firebase service account related - obtain from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=service-account@your-project-id.iam.gserviceaccount.com
# Put the private key as a single line with escaped \n newlines
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...snip...\n-----END PRIVATE KEY-----\n

# Firebase web config - obtain from Project Settings > General > Your apps
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_WEB_API_KEY=your-web-api-key
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:abcdefabcdef

# Optional base URL for backend (used for deep links)
BACKEND_BASE_URL=http://localhost:3001
